# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (contains SDK path — machine specific)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log
hs_err_pid*.log
replay_pid*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Google Services (e.g. APIs or Firebase)
# Injected at build time via Jenkins credentials — do NOT commit
google-services.json

# Signing credential files — never commit
*.p12
*.keystore
*.jks
